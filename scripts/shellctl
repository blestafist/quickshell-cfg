#!/usr/bin/env sh

set -eu

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"

usage() {
    cat <<'EOF'
Usage: shellctl <command>

Commands:
  open         Open the launcher.
  toggle       Toggle the launcher.
  close        Close the launcher.
  reload       Reload the active QuickShell configuration.
  start        Start QuickShell if it is not already running.
  diagnostics  Check required and optional runtime dependencies.
EOF
}

require_command() {
    if command -v "$1" >/dev/null 2>&1; then
        printf 'ok       %s\n' "$1"
    else
        printf 'missing  %s\n' "$1"
        return 1
    fi
}

case "${1:-}" in
    open)
        exec qs -p "$config_dir" ipc call shell openLauncher
        ;;
    toggle)
        exec qs -p "$config_dir" ipc call shell toggleLauncher
        ;;
    close)
        exec qs -p "$config_dir" ipc call shell closeLauncher
        ;;
    reload)
        qs -p "$config_dir" kill || true
        # IPC shutdown is asynchronous; wait briefly before --no-duplicate checks.
        sleep 1
        exec qs -p "$config_dir" -n -d
        ;;
    start)
        # --no-duplicate makes this idempotent without parsing human-readable output.
        exec qs -p "$config_dir" -n -d
        ;;
    diagnostics)
        status=0
        printf '%s\n' 'Required:'
        require_command qs || status=1
        require_command hyprctl || status=1
        require_command wpctl || status=1
        require_command nmcli || status=1
        printf '%s\n' 'Optional:'
        require_command nvidia-smi || true
        require_command swww || true
        require_command matugen || true
        require_command jq || true
        exit "$status"
        ;;
    *)
        usage
        exit 2
        ;;
esac
