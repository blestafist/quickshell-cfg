#!/usr/bin/env python3
import os
import sys
import time

args = sys.argv[1:]
with open(os.environ['TRACE'], 'a') as trace:
    trace.write(' '.join(args) + '\n')
if 'ipc' not in args:
    time.sleep(0.1)
    sys.exit(0)
method = args[-1]
scenario = os.environ.get('SCENARIO', 'secure')
if method == 'lock':
    print('true')
elif method == 'status':
    print({'idle': 'idle', 'unlocking': 'unlocking', 'malformed': 'true',
           'timeout': 'acquiring'}.get(scenario, 'secure'))
elif method == 'suspend':
    print('false' if scenario == 'race' else 'true')
elif method == 'suspendStatus':
    print('failed' if scenario == 'failure' else 'done')
